{
  "name": "limawsk7/sistema",
  "description": "Sistema de páginas e gerenciamento de conteúdo",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "codeigniter4/framework": "^4.6",
    "codeigniter4/shield": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": ["**/Database/Migrations/**"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}